# Copy to .env (gitignored). All placeholders — replace before prod.

# Postgres
POSTGRES_USER=seta
POSTGRES_PASSWORD=seta_dev_pw
POSTGRES_DB=seta
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://seta:seta_dev_pw@localhost:5432/seta?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# NATS
NATS_PORT=4222
NATS_MON_PORT=8222
NATS_URL=nats://localhost:4222

# JWT — generate w/ `openssl rand -base64 48` before any real use
JWT_SECRET=changeme_changeme_changeme_changeme_changeme_
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Service ports
AUTH_HTTP_PORT=8081
TEAM_HTTP_PORT=8082
ASSET_HTTP_PORT=8083

# Log
LOG_LEVEL=info
