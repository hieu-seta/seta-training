{
  "uid": "seta-overview",
  "title": "Seta Overview (all services)",
  "tags": ["seta", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by service",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 9 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 30, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({container=~\"seta-(auth|team|asset|audit-worker)\"} [1m]))",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors last 1h (auth)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 9, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({container=\"seta-auth\"} | json | level=\"error\" [1h]))", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors last 1h (team)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 6, "y": 9, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({container=\"seta-team\"} | json | level=\"error\" [1h]))", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors last 1h (asset)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 9, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({container=\"seta-asset\"} | json | level=\"error\" [1h]))", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Errors last 1h (audit)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 18, "y": 9, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({container=\"seta-audit-worker\"} | json | level=\"error\" [1h]))", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent errors (all services)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 10 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"seta-(auth|team|asset|audit-worker)\"} | json | level=\"error\"",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    }
  ]
}
